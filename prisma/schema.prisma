generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  fname     String
  lname     String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpCode{
  id        Int    @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime  @default(now())
}